+def _thumbnail(data, out_png: Path) -> None:
+    """Two-panel thumbnail for eyeball labelling: the whole frame
+    (mean-binned, asinh stretch) and a 2x-binned zoom on the brightest
+    region.  No text is drawn — the sheets carry only an anonymous id."""
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+    import numpy as np
+    ny, nx = data.shape
+    b = max(1, max(ny, nx) // 512)
+    gy, gx = ny // b, nx // b
+    small = data[:gy * b, :gx * b].reshape(gy, b, gx, b).mean(axis=(1, 3))
+    med = float(np.median(small))
+    # Zoom centre: brightest cell of a coarse (64-px mean) map, away from
+    # the border — the target or its trace.
+    c = 64
+    cy_, cx_ = ny // c, nx // c
+    coarse = data[:cy_ * c, :cx_ * c].reshape(cy_, c, cx_, c).mean(axis=(1, 3))
+    iy, ix = np.unravel_index(int(np.argmax(coarse[1:-1, 1:-1])),
+                              coarse[1:-1, 1:-1].shape)
+    zy, zx = (iy + 1) * c + c // 2, (ix + 1) * c + c // 2
+    hw_y, hw_x = min(400, ny // 2), min(600, nx // 2)
+    y0 = int(np.clip(zy - hw_y, 0, ny - 2 * hw_y))
+    x0 = int(np.clip(zx - hw_x, 0, nx - 2 * hw_x))
+    zoom = data[y0:y0 + 2 * hw_y, x0:x0 + 2 * hw_x]
+    zoom = zoom[:zoom.shape[0] // 2 * 2, :zoom.shape[1] // 2 * 2]
+    zoom = zoom.reshape(zoom.shape[0] // 2, 2, zoom.shape[1] // 2, 2).mean(
+        axis=(1, 3))
+
+    def stretch(img):
+        lo = float(np.percentile(img, 5.0))
+        hi = float(np.percentile(img, 99.8))
+        scale = max(hi - lo, 1e-6)
+        return np.arcsinh(10.0 * np.clip((img - lo) / scale, 0, None))
+
+    fig, axes = plt.subplots(1, 2, figsize=(6.4, 2.6), dpi=100)
+    axes[0].imshow(stretch(small), origin="lower", cmap="gray")
+    axes[1].imshow(stretch(zoom), origin="lower", cmap="gray")
+    for ax in axes:
+        ax.set_xticks([])
+        ax.set_yticks([])
+    fig.subplots_adjust(left=0.01, right=0.99, top=0.99, bottom=0.01,
+                        wspace=0.02)
+    out_png.parent.mkdir(parents=True, exist_ok=True)
+    fig.savefig(out_png)
+    plt.close(fig)
+
+
+def _morph_task(task: dict) -> tuple[int, dict]:
+    """Worker: read one frame, return its morphology numbers; write the
+    background map (always) and a thumbnail (truth frames only)."""
+    import numpy as np
+    from macro_grism.fits_io import load_frame
+    rid, rel = task["obs_rowid"], task["path"]
+    try:
+        data, _h, _l = load_frame(str(Path(task["archive"]) / rel))
+    except Exception as exc:                             # noqa: BLE001
+        return rid, {"morph_status": "unreadable",
+                     "morph_reason": f"{type(exc).__name__}: {exc}"[:200]}
+    bmap = dsp.background_map(data)
+    m = dsp.morphology_metrics(bmap)
+    cls, why = dsp.classify_morphology(m)
+    out_dir = Path(task["truth_dir"])
+    map_file = out_dir / "maps" / f"{rid}.npy"
+    map_file.parent.mkdir(parents=True, exist_ok=True)
+    np.save(map_file, bmap.astype(np.float32))
+    res = {"morph_status": "measured", "bg_corner": m["corner"],
+           "bg_edge_tb": m["edge_tb"], "bg_peak": m["peak"],
+           "bg_sigma": m["sigma"], "bg_contrast": m["contrast"],
+           "bg_edge_ratio": m["edge_ratio"], "bg_area_frac": m["area_frac"],
+           "morph_class": cls, "morph_reason": why,
+           "map_file": f"truth/maps/{rid}.npy"}
+    if task.get("truth_idx"):
+        png = out_dir / "thumbs" / f"t{task['truth_idx']:03d}.png"
+        _thumbnail(data, png)
+        res["thumb_file"] = f"truth/thumbs/{png.name}"
+    return rid, res
+
+
+def cmd_morph_run(args) -> int:
+    """Measure pending frames (resumable; a killed run loses only the
+    frames in flight)."""
+    gcon = _grism_con()
+    rows = gcon.execute(
+        "SELECT obs_rowid, path, truth_idx FROM frame_dispersion "
+        "WHERE morph_status = 'pending' ORDER BY "
+        "(truth_idx IS NULL), samples, obs_rowid").fetchall()
+    if args.limit:
+        rows = rows[:args.limit]
+    tasks = [{"obs_rowid": r[0], "path": r[1], "truth_idx": r[2],
+              "archive": str(args.archive), "truth_dir": str(TRUTH_DIR)}
+             for r in rows]
+    print(f"morph-run: {len(tasks)} pending")
+    t0, n = time.time(), 0
+    with concurrent.futures.ProcessPoolExecutor(args.workers) as pool:
+        for rid, res in pool.map(_morph_task, tasks, chunksize=1):
+            keys = list(res)
+            gcon.execute(
+                f"UPDATE frame_dispersion SET "
+                f"{', '.join(k + ' = ?' for k in keys)} WHERE obs_rowid = ?",
+                [res[k] for k in keys] + [rid])
+            gcon.commit()        # one frame = one transaction: other G
+            n += 1               # runners write this database too
+            if n % 10 == 0:
+                print(f"  {n}/{len(tasks)}  ({time.time() - t0:.0f}s)")
+            if args.max_seconds and time.time() - t0 > args.max_seconds:
+                break
+    gcon.commit()
+    return 0
+
+
+def _filter_class(filt) -> str:
+    """Template group of a FILTER card: the two named units, the two
+    disputed slots, or 'ordinary'."""
+    f = (filt or "").strip().lower()
+    return {"hrg": "hrg", "hagrism": "hrg", "hag": "hrg", "lrg": "lrg",
+            "oggrism": "lrg", "6": "slot6", "w": "slotW"}.get(f, "ordinary")
+
+
+def cmd_morph_reclassify(args) -> int:
+    """Recompute everything that needs no pixels: the noise floor, the
+    lozenge-template correlation (leave-one-target-out), the morphology
+    class and the re-issued verdict — from the STORED background maps."""
+    import numpy as np
+    gcon = _grism_con()
+    have = {r[1] for r in gcon.execute("PRAGMA table_info(frame_dispersion)")}
+    for col, typ in (("bg_template_r", "REAL"), ("bg_template", "TEXT")):
+        if col not in have:                       # database predates them
+            gcon.execute(f"ALTER TABLE frame_dispersion ADD COLUMN {col} {typ}")
+    rows = gcon.execute(
+        "SELECT obs_rowid, verdict_v1, filter, height, width, "
+        "canonical_target FROM frame_dispersion "
+        "WHERE morph_status = 'measured'").fetchall()
+    metrics, norm = {}, {}
+    for rid, *_ in rows:
+        bmap = np.load(TRUTH_DIR / "maps" / f"{rid}.npy")
+        metrics[rid] = dsp.morphology_metrics(bmap)
+        norm[rid] = dsp.normalized_map(bmap)
+    # Template members: frames the TRACE test calls dispersed, under a
+    # grism-capable card, with strong diffuse light; grouped by
+    # (card class, frame shape).
+    groups: dict = {}
+    for rid, v1, filt, h, w, tgt in rows:
+        cls = _filter_class(filt)
+        if (v1 == dsp.VERDICT_DISPERSED and cls != "ordinary"
+                and (metrics[rid]["contrast"] or 0)
+                >= dsp.MORPH_TEMPLATE_MIN_CONTRAST):
+            groups.setdefault((cls, h, w), []).append((rid, tgt))
+    n_tpl = {k: len(v) for k, v in groups.items()}
+    print("template groups:", {f"{k[0]} {k[2]}x{k[1]}": n
+                               for k, n in sorted(n_tpl.items())})
+    for rid, v1, filt, h, w, tgt in rows:
+        # Leave-one-target-out: no frame of this frame's target (and not
+        # the frame itself) contributes to the templates it is judged by.
+        tpls = {}
+        for key, members in groups.items():
+            use = [norm[m] for m, t in members
+                   if m != rid and (t is None or tgt is None or t != tgt)]
+            tpls[key] = dsp.build_template(use)
+        r, key, rot = dsp.template_correlation(norm[rid], tpls)
+        m = dict(metrics[rid])
+        m["template_r"] = r
+        cls, why = dsp.classify_morphology(m)
+        verdict, basis = dsp.combine_verdicts(v1, cls)
+        gcon.execute(
+            "UPDATE frame_dispersion SET bg_sigma = ?, bg_contrast = ?, "
+            "bg_edge_ratio = ?, bg_area_frac = ?, bg_template_r = ?, "
+            "bg_template = ?, morph_class = ?, morph_reason = ?, "
+            "verdict = ?, verdict_basis = ?, code_version = ? "
+            "WHERE obs_rowid = ?",
+            (m["sigma"], m["contrast"], m["edge_ratio"], m["area_frac"], r,
+             None if key is None else f"{key[0]} {key[2]}x{key[1]} rot{rot}",
+             cls, why, verdict, basis, dsp.DISPERSION_CODE_VERSION, rid))
+    gcon.commit()
+    print(f"morph-reclassify: {len(rows)} frames re-judged")
+    return 0
+
+
+def wilson(k: int, n: int, z: float = 1.959964) -> tuple[float, float]:
+    """Wilson score interval for a binomial proportion k/n (95% by
+    default).  Returns (lo, hi); (nan, nan) for n = 0."""
+    if n == 0:
+        return float("nan"), float("nan")
+    p = k / n
+    denom = 1 + z * z / n
+    centre = (p + z * z / (2 * n)) / denom
+    half = z * ((p * (1 - p) / n + z * z / (4 * n * n)) ** 0.5) / denom
+    return max(0.0, centre - half), min(1.0, centre + half)
+
+
+def cmd_morph_calibrate(args) -> int:
+    """Where the undisputed-label populations fall in the three
+    morphology numbers (the evidence the thresholds rest on)."""
+    import numpy as np
+    gcon = _grism_con()
+    print(f"{'sample':16s} {'n':>4s} {'class counts':40s}  "
+          f"contrast p10/p50/p90      edge_ratio p10/p50/p90   "
+          f"template_r min/p10/p50/p90/max")
+    for sample in ("calib_dispersed", "calib_direct"):
+        rows = gcon.execute(
+            "SELECT morph_class, bg_contrast, bg_edge_ratio, bg_template_r, "
+            "exptime FROM frame_dispersion WHERE morph_status='measured' "
+            "AND samples LIKE ?", (f"%{sample}%",)).fetchall()
+        for label, sub in (("all", rows),
+                           (">=60s", [r for r in rows if (r[4] or 0) >= 60])):
+            if not sub:
+                continue
+            cls = {}
+            for r in sub:
+                cls[r[0]] = cls.get(r[0], 0) + 1
+
+            def pct(i):
+                v = np.array([r[i] for r in sub if r[i] is not None])
+                q = [0, 10, 50, 90, 100] if i == 3 else [10, 50, 90]
+                return ("   n/a" if len(v) == 0 else
+                        "/".join(f"{x:8.2f}" for x in np.percentile(v, q)))
+            print(f"{sample:16s} {len(sub):4d} "
+                  f"{label + ' ' + str(cls):40s}  {pct(1)}  {pct(2)}  "
+                  f"{pct(3)}")
+    return 0
+
