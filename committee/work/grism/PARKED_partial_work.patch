+MORPH_SCHEMA = """
+CREATE TABLE IF NOT EXISTS frame_dispersion (
+    obs_rowid        INTEGER PRIMARY KEY,
+    path             TEXT NOT NULL,
+    tree             TEXT,
+    filter           TEXT,
+    night            TEXT,
+    canonical_target TEXT,
+    exptime          REAL,
+    xbinning         REAL,
