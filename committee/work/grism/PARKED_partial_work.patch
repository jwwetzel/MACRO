+def cmd_reissue(args) -> int:
+    """Re-issued verdicts for the disputed slots, per target/slot and per
+    night, written as a tracked CSV."""
+    import csv
+    mcon = connect(args.manifest, read_only=True)
+    gcon = _grism_con()
+    tgt = {r[0]: r[1] for r in mcon.execute(
+        "SELECT obs_rowid, target_best FROM frames WHERE "
+        "lower(target_best) IN ('ngc 5548','ngc5548','t crb')")}
+    rows = gcon.execute(
+        "SELECT obs_rowid, path, filter, night, exptime, verdict_v1, "
+        "verdict, verdict_basis, morph_class, bg_contrast, bg_edge_ratio, "
+        "bg_area_frac FROM frame_dispersion WHERE samples LIKE '%reissue%' "
+        "AND morph_status = 'measured' ORDER BY night, path").fetchall()
+    out_csv = WORK_DIR / "reissued_verdicts.csv"
+    with open(out_csv, "w", newline="") as fh:
+        w = csv.writer(fh)
+        w.writerow(["target", "filter", "night", "path", "exptime",
+                    "verdict_v1", "verdict_v2", "basis", "morph_class",
+                    "contrast", "edge_ratio", "area_frac"])
+        for r in rows:
+            w.writerow([tgt.get(r[0], "")] + list(r[2:4]) + [r[1]]
+                       + [f"{r[4]:.1f}"] + list(r[5:9])
+                       + [("" if v is None else f"{v:.3f}") for v in r[9:]])
+    groups: dict = {}
+    for r in rows:
+        key = (tgt.get(r[0], "").upper().replace("NGC5548", "NGC 5548"),
+               r[2].upper())
+        g = groups.setdefault(key, {"n": 0, "v1": {}, "v2": {},
+                                    "nights": {}})
+        g["n"] += 1
+        g["v1"][r[5]] = g["v1"].get(r[5], 0) + 1
+        g["v2"][r[6]] = g["v2"].get(r[6], 0) + 1
+        nn = g["nights"].setdefault(r[3], {})
+        nn[r[6]] = nn.get(r[6], 0) + 1
+    for key in sorted(groups):
+        g = groups[key]
+        print(f"\n{key[0]} slot {key[1]}: {g['n']} frames")
+        print(f"   v1 (traces only):  {dict(sorted(g['v1'].items()))}")
+        print(f"   v2 (traces + sky): {dict(sorted(g['v2'].items()))}")
+        nights_all = sum(1 for v in g["nights"].values()
+                         if set(v) == {"dispersed"})
+        print(f"   nights: {len(g['nights'])}, of which every frame "
+              f"dispersed on {nights_all}")
+    print(f"\nper-frame table: {out_csv}")
+    return 0
