+def cmd_truth_sheets(args) -> int:
+    """Contact sheets of the truth-set thumbnails, 12 per sheet, labelled
+    ONLY with the anonymous truth index — the labeller sees neither the
+    filter card nor either classifier's verdict."""
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.image as mpimg
+    import matplotlib.pyplot as plt
+    gcon = _grism_con()
+    rows = gcon.execute(
+        "SELECT truth_idx, thumb_file FROM frame_dispersion "
+        "WHERE truth_idx IS NOT NULL AND thumb_file IS NOT NULL "
+        "ORDER BY truth_idx").fetchall()
+    sheets = TRUTH_DIR / "sheets"
+    sheets.mkdir(parents=True, exist_ok=True)
+    per = 12
+    for s0 in range(0, len(rows), per):
+        chunk = rows[s0:s0 + per]
+        fig, axes = plt.subplots(4, 3, figsize=(19.2, 10.6), dpi=75)
+        for ax in axes.ravel():
+            ax.axis("off")
+        for ax, (idx, thumb) in zip(axes.ravel(), chunk):
+            ax.imshow(mpimg.imread(TRUTH_DIR.parent / thumb))
+            ax.set_title(f"#{idx}", fontsize=13, loc="left", pad=2)
+        fig.subplots_adjust(left=0.005, right=0.995, top=0.97, bottom=0.005,
+                            wspace=0.02, hspace=0.10)
+        out = sheets / f"sheet_{chunk[0][0]:03d}_{chunk[-1][0]:03d}.png"
+        fig.savefig(out)
+        plt.close(fig)
+        print(f"sheet: {out}")
+    return 0
