+    strength_class   TEXT,
+    reason           TEXT,
+    measure_s REAL, error TEXT, code_version TEXT, measured_at TEXT,
+    -- ---- added 2026-10-03 (F-6) ----
+    verdict_v1       TEXT,            -- the trace-only verdict it replaces
+    verdict_basis    TEXT,            -- which witness(es) decided
+    samples          TEXT,            -- calib_dispersed|calib_direct|
+                                      -- truth|reissue (comma-joined)
+    truth_idx        INTEGER,         -- anonymous id on the contact sheets
+    morph_status     TEXT,            -- pending | measured | unreadable
+    bg_corner REAL, bg_edge_tb REAL, bg_peak REAL, bg_sigma REAL,
+    bg_contrast REAL, bg_edge_ratio REAL, bg_area_frac REAL,
+    bg_template_r REAL,               -- best lozenge-template correlation
+    bg_template   TEXT,               -- which template (class/shape/rot)
+    morph_class      TEXT,
+    morph_reason     TEXT,
+    map_file         TEXT,            -- products-relative background map
+    thumb_file       TEXT             -- products-relative thumbnail
+);
+CREATE TABLE IF NOT EXISTS s2c_truth (
+    truth_idx   INTEGER PRIMARY KEY,
+    path        TEXT,
+    label       TEXT,                 -- dispersed | direct | unusable
+    note        TEXT,
+    labelled_by TEXT,
+    labelled_at TEXT
+);
+CREATE TABLE IF NOT EXISTS s2c_morph_meta (key TEXT PRIMARY KEY, value TEXT);
+"""
+
+#: Truth-set strata: (name, SQL predicate over the manifest's
+#: frame_dispersion, target count).  The weights follow DS.F8 — the
+#: populations whose verdicts nobody has ever checked get the most
+#: frames: grism-labelled frames called direct or indeterminate, the
+#: disputed slots, and the ordinary-filter frames called dispersed.
+_NAMED = "lower(filter) IN ('hrg','lrg','hagrism','oggrism','hag')"
+_ORD = "filter IN ('g','r','i','V','R','I','B','L')"
+TRUTH_STRATA = (
+    ("named_grism/dispersed",     f"{_NAMED} AND verdict='dispersed'", 20),
+    ("named_grism/indeterminate", f"{_NAMED} AND verdict='indeterminate'", 30),
+    ("named_grism/direct",        f"{_NAMED} AND verdict='direct'", 30),
+    ("slot6/dispersed",           "filter='6' AND verdict='dispersed'", 15),
+    ("slot6/indeterminate",       "filter='6' AND verdict='indeterminate'", 20),
+    ("slot6/direct",              "filter='6' AND verdict='direct'", 20),
+    ("slotW/dispersed",           "lower(filter)='w' AND verdict='dispersed'", 8),
+    ("slotW/indeterminate",       "lower(filter)='w' AND verdict='indeterminate'", 8),
+    ("slotW/direct",              "lower(filter)='w' AND verdict='direct'", 9),
+    ("ordinary/dispersed",        f"{_ORD} AND verdict='dispersed'", 20),
+    ("ordinary/indeterminate",    f"{_ORD} AND verdict='indeterminate'", 8),
+    ("ordinary/direct",           f"{_ORD} AND verdict='direct'", 12),
+)
+TRUTH_SEED = 20261003
+CALIB_SEED = 20261004
+CALIB_PER_CLASS = 150
+
+
+def _grism_con():
+    GRISM_DB.parent.mkdir(parents=True, exist_ok=True)
+    con = sqlite3.connect(str(GRISM_DB), timeout=300)
+    con.executescript(MORPH_SCHEMA)
+    return con
+
+
+def _fd_columns(con) -> list[str]:
+    """Column names shared by the manifest's frame_dispersion and ours."""
+    return ["obs_rowid", "path", "tree", "filter", "night",
+            "canonical_target", "exptime", "xbinning", "era_id",
+            "population", "priority", "status", "n_detected", "n_sources",
+            "n_bright", "median_ab", "max_ab", "pa_median", "pa_scatter",
+            "n_trace", "trace_frac", "trace_ab", "trace_a_px", "trace_pa",
+            "trace_pa_scatter", "detect_sigma", "height", "width",
+            "verdict", "strength_class", "reason", "measure_s", "error",
+            "code_version", "measured_at"]
+
