+def cmd_truth_score(args) -> int:
+    """Load the eyeball labels, store them, and print the confusion
+    matrices (v1 trace-only verdict and v2 two-witness verdict against
+    truth) with Wilson 95% intervals; also written as a tracked CSV."""
+    import csv
+    gcon = _grism_con()
+    if not LABELS_CSV.exists():
+        print(f"truth-score: no labels file at {LABELS_CSV}")
+        return 2
+    with open(LABELS_CSV, newline="") as fh:
+        labels = [r for r in csv.DictReader(fh)]
+    gcon.execute("DELETE FROM s2c_truth")
+    for r in labels:
+        path = gcon.execute("SELECT path FROM frame_dispersion WHERE "
+                            "truth_idx = ?", (int(r["truth_idx"]),)).fetchone()
+        gcon.execute("INSERT INTO s2c_truth VALUES (?,?,?,?,?,?)",
+                     (int(r["truth_idx"]), path[0] if path else None,
+                      r["label"], r.get("note", ""),
+                      r.get("labelled_by", ""), r.get("labelled_at", "")))
+    gcon.commit()
+    rows = gcon.execute("""
+        SELECT t.label, d.verdict_v1, d.verdict, d.filter
+        FROM s2c_truth t JOIN frame_dispersion d USING (truth_idx)
+        WHERE d.morph_status = 'measured'""").fetchall()
+    verdicts = ("dispersed", "indeterminate", "direct")
+    truths = ("dispersed", "direct", "unusable")
+    out_lines = []
+    for name, col in (("v1 (traces only)", 1), ("v2 (traces + sky)", 2)):
+        print(f"\nConfusion matrix — {name}   rows = truth, cols = verdict")
+        print(f"{'truth':12s} " + " ".join(f"{v:>14s}" for v in verdicts)
+              + f" {'n':>5s}")
+        for t in truths:
+            sub = [r for r in rows if r[0] == t]
+            counts = [sum(1 for r in sub if r[col] == v) for v in verdicts]
+            print(f"{t:12s} " + " ".join(f"{c:14d}" for c in counts)
+                  + f" {len(sub):5d}")
+            for v, c in zip(verdicts, counts):
+                lo, hi = wilson(c, len(sub))
+                out_lines.append([name, t, v, c, len(sub),
+                                  f"{c / len(sub):.4f}" if sub else "",
+                                  f"{lo:.4f}", f"{hi:.4f}"])
+        # The rates that matter, stated as rates.
+        disp_t = [r for r in rows if r[0] == "dispersed"]
+        dir_t = [r for r in rows if r[0] == "direct"]
+        for label, sub, bad in (
+                ("spectra certified 'direct' (the dangerous error)",
+                 disp_t, "direct"),
+                ("spectra recognised as dispersed (sensitivity)",
+                 disp_t, "dispersed"),
+                ("images called 'dispersed' (false positive)",
+                 dir_t, "dispersed"),
+                ("images certified direct", dir_t, "direct")):
+            k = sum(1 for r in sub if r[col] == bad)
+            lo, hi = wilson(k, len(sub))
+            rate = k / len(sub) if sub else float("nan")
+            print(f"  {label:50s} {k:3d}/{len(sub):3d} = {rate:6.1%}  "
+                  f"Wilson 95% [{lo:.1%}, {hi:.1%}]")
+    out_csv = WORK_DIR / "truth_confusion.csv"
+    with open(out_csv, "w", newline="") as fh:
+        w = csv.writer(fh)
+        w.writerow(["classifier", "truth", "verdict", "k", "n", "rate",
+                    "wilson95_lo", "wilson95_hi"])
+        w.writerows(out_lines)
+    print(f"\nconfusion table: {out_csv}")
+    return 0
+
