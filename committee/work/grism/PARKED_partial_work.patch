+def cmd_morph_plan(args) -> int:
+    """Choose the F-6 frames and copy their v1 rows into the grism DB.
+
+    Three disjoint-by-construction draws from the manifest's measured
+    ``frame_dispersion`` rows (fixed seeds, so the plan is reproducible):
+
+    1. the TRUTH set (stratified; drawn first so nothing else can shape
+       it), 2. the threshold-CALIBRATION sample (named grisms judged
+       dispersed vs ordinary filters judged direct — labels nobody
+       disputes), excluded from the truth set, 3. the RE-ISSUE frames
+       (NGC 5548 slot '6'; T CrB slot '6'/'W') — these MAY overlap the
+       truth set (a truth frame is just a frame that was also looked at).
+    """
+    mcon = connect(args.manifest, read_only=True)
+    gcon = _grism_con()
+    cols = _fd_columns(mcon)
+    sel = ", ".join(cols)
+    chosen: dict[int, dict] = {}
+
+    def add(rows, sample):
+        for r in rows:
+            d = dict(zip(cols, r))
+            cur = chosen.setdefault(d["obs_rowid"], d)
+            cur.setdefault("_samples", set()).add(sample)
+
+    # 1. truth set
+    rng = random.Random(TRUTH_SEED)
+    truth_ids = []
+    for name, pred, n in TRUTH_STRATA:
+        rows = mcon.execute(
+            f"SELECT {sel} FROM frame_dispersion WHERE status='measured' "
+            f"AND {pred} ORDER BY obs_rowid").fetchall()
+        pick = rows if len(rows) <= n else rng.sample(rows, n)
+        add(pick, "truth")
+        truth_ids += [r[0] for r in pick]
+        print(f"  truth stratum {name:28s} {len(pick):3d} of {len(rows)}")
+    # 2. calibration sample (disjoint from truth)
+    rng = random.Random(CALIB_SEED)
+    for sample, pred in (
+            ("calib_dispersed", f"{_NAMED} AND verdict='dispersed'"),
+            ("calib_direct", f"{_ORD} AND verdict='direct'")):
+        rows = [r for r in mcon.execute(
+            f"SELECT {sel} FROM frame_dispersion WHERE status='measured' "
+            f"AND {pred} ORDER BY obs_rowid") if r[0] not in set(truth_ids)]
+        add(rng.sample(rows, min(CALIB_PER_CLASS, len(rows))), sample)
+    # 3. re-issue frames
+    rows = mcon.execute(f"""
+        SELECT {", ".join("d." + c for c in cols)}
+        FROM frame_dispersion d JOIN frames f USING (obs_rowid)
+        WHERE f.is_canonical = 1 AND d.status = 'measured'
+          AND ((lower(f.target_best) IN ('ngc 5548','ngc5548')
+                AND d.filter = '6')
+            OR (lower(f.target_best) = 't crb'
+                AND lower(d.filter) IN ('6','w')))""").fetchall()
+    add(rows, "reissue")
+    # Anonymous truth indices in a shuffled order (the sheets must not
+    # reveal the stratum by position).
+    order = list(truth_ids)
+    random.Random(TRUTH_SEED + 1).shuffle(order)
+    truth_idx = {rid: i + 1 for i, rid in enumerate(order)}
+    n_new = 0
+    for rid, d in chosen.items():
+        samples = ",".join(sorted(d.pop("_samples")))
+        exists = gcon.execute("SELECT morph_status FROM frame_dispersion "
+                              "WHERE obs_rowid = ?", (rid,)).fetchone()
+        if exists:
+            gcon.execute("UPDATE frame_dispersion SET samples = ?, "
+                         "truth_idx = ? WHERE obs_rowid = ?",
+                         (samples, truth_idx.get(rid), rid))
+            continue
+        d.update(verdict_v1=d["verdict"], samples=samples,
+                 truth_idx=truth_idx.get(rid), morph_status="pending")
+        keys = list(d)
+        gcon.execute(
+            f"INSERT INTO frame_dispersion ({','.join(keys)}) "
+            f"VALUES ({','.join('?' * len(keys))})", [d[k] for k in keys])
+        n_new += 1
+    gcon.execute("INSERT OR REPLACE INTO s2c_morph_meta VALUES (?, ?)",
+                 ("planned_at", utcnow()))
+    gcon.execute("INSERT OR REPLACE INTO s2c_morph_meta VALUES (?, ?)",
+                 ("truth_seed", str(TRUTH_SEED)))
+    gcon.execute("INSERT OR REPLACE INTO s2c_morph_meta VALUES (?, ?)",
+                 ("calib_seed", str(CALIB_SEED)))
+    gcon.commit()
+    print(f"morph-plan: {len(chosen)} frames ({n_new} new); truth set "
+          f"{len(truth_ids)}")
+    return 0
+
