+        for j, (_p, mode, eg, t_exp, _f) in enumerate(frames_):
+            fs_ = _frame_scale(scale, mode, eg, t_exp)
+            if fs_ is None:
+                continue
+            pfrac[:, j] = lin.peak_fraction(peak[:, j], fs_[0], fs_[1])
