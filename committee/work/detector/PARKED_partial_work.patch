--- a/pipeline/rlmt_diagnostics/linearity.py
+++ b/pipeline/rlmt_diagnostics/linearity.py
@@ -216,3 +216,426 @@ def group_ladders(rows: Sequence[tuple],
     out.sort(key=lambda d: (-len(d["rungs"]), -d["n_frames"],
                             d["night"] or "", d["target_key"]))
