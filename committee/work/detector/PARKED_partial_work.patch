+def _central_level(img: np.ndarray) -> float:
+    """Median of the central quarter of a frame (the level a pair is at)."""
+    ny, nx = img.shape
+    return float(np.median(img[ny // 4: 3 * ny // 4, nx // 4: 3 * nx // 4]))
+
